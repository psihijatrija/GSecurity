; -----------------------------------------------------------------------------
; SECTION 5 - POWERSHELL HARDENING
; (Sentinel: AMSI patch, ETW patch, ReflectiveLoad, InvokeExpr, DownloadMethods)
; -----------------------------------------------------------------------------

; Script block logging - records all PS script content including deobfuscated
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\PowerShell\ScriptBlockLogging]
"EnableScriptBlockLogging"=dword:00000001
"EnableScriptBlockInvocationLogging"=dword:00000001

; Module logging - logs all module activity
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\PowerShell\ModuleLogging]
"EnableModuleLogging"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\PowerShell\ModuleLogging\ModuleNames]
"*"="*"

; Transcription logging
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\PowerShell\Transcription]
"EnableTranscripting"=dword:00000001
"EnableInvocationHeader"=dword:00000001
"OutputDirectory"="C:\\Windows\\System32\\LogFiles\\PowerShell"

; Constrained Language Mode - REMOVED (full language mode allowed)
; __PSLockdownPolicy key is deleted on import so PowerShell runs unrestricted
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Session Manager\Environment]
"__PSLockdownPolicy"=-

; Disable PowerShell v2 fallback (bypasses logging) - disable engine
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\PowerShell]
"EnableScripts"=dword:00000001
"ExecutionPolicy"="Unrestricted"
"DisableRemoteExecution"=dword:00000001

; -----------------------------------------------------------------------------
; SECTION 6 - SCRIPT HOST (ENABLED)
; WScript / CScript left enabled for local scripting use.
; Remove the keys below or set Enabled=0 to re-block.
; -----------------------------------------------------------------------------

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Script Host\Settings]
"Enabled"=dword:00000001
"ActiveDebugging"=dword:00000000
"DisplayLogo"=dword:00000000
"SilentTerminate"=dword:00000001
"UseWINSAFER"=dword:00000001

[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows Script Host\Settings]
"Enabled"=dword:00000001


; -----------------------------------------------------------------------------
; SECTION 7 - WINDOWS DEFENDER POLICY LOCK
; (Sentinel: DefenderDisable / DefenderExclude detections)
; -----------------------------------------------------------------------------

; Prevent disabling real-time protection via policy
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows Defender]
"DisableAntiSpyware"=dword:00000000
"DisableAntiVirus"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows Defender\Real-Time Protection]
"DisableRealtimeMonitoring"=dword:00000000
"DisableIOAVProtection"=dword:00000000
"DisableBehaviorMonitoring"=dword:00000000
"DisableOnAccessProtection"=dword:00000000
"DisableScanOnRealtimeEnable"=dword:00000000

; Tamper protection advisory - note: TamperProtection itself is enforced via
; Security Center / Intune, not registry on standalone systems. The policy
; below disables the local override path.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows Defender\Features]
"TamperProtection"=dword:00000005

; SmartScreen
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows Defender\SmartScreen]
"EnableSmartScreenInShell"=dword:00000001
"PreventOverrideForFilesInShell"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge]
"SmartScreenEnabled"=dword:00000001
"SafeBrowsingProtectionLevel"=dword:00000001
"QuicAllowed"=dword:00000000

[HKEY_LOCAL_MACHINE\Software\Policies\Google\Chrome]
"QuicAllowed"=dword:00000000


; -----------------------------------------------------------------------------
; SECTION 8 - ATTACK SURFACE REDUCTION (ASR) RULES
; Source: Security.reg > GShield.reg
; (Sentinel: Office macro chains, LOLBin execution, credential access, persistence)
; -----------------------------------------------------------------------------

[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows Defender\Windows Defender Exploit Guard\ASR]
"ExploitGuard_ASR_Rules"=dword:00000001

[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows Defender\Windows Defender Exploit Guard\ASR\Rules]
; Block abuse of exploited vulnerable signed drivers
"56a863a9-875e-4185-98a7-b882c64b5ce5"="1"
; Block Adobe Reader from creating child processes
"7674ba52-37eb-4a4f-a9a1-f0f9a1619a2c"="1"
; Block all Office apps from creating child processes
"D4F940AB-401B-4EFC-AADC-AD5F3C50688A"="1"
; Block credential stealing from LSASS (Sentinel: LsassComsvcs / LsassDump)
"9e6c4e1f-7d60-472f-ba1a-a39ef669e4b2"="1"
; Block executable content from email/webmail (Sentinel: phishing chains)
"BE9BA2D9-53EA-4CDC-84E5-9B1EEEE46550"="1"
; Block executable files unless they meet prevalence/age/trusted list criteria - AUDIT only
"01443614-cd74-433a-b99e-2ecdc07bfc25"="2"
; Block execution of potentially obfuscated scripts (Sentinel: InvokeExpr/AMSI)
"5BEB7EFE-FD9A-4556-801D-275E5FFC04CC"="1"
; Block JS/VBS from launching downloaded executable content
"D3E037E1-3EB8-44C8-A917-57927947596D"="1"
; Block JS/VBS/PS from launching executables (Sentinel: LOLBin chains)
"3B576869-A4EC-4529-8536-B80A7769E899"="1"
; Block Office apps from creating executable content
"3B576869-A4EC-4529-8536-B80A7769E899"="1"
; Block Office apps from injecting code into other processes
"75668C1F-73B5-4CF0-BB93-3ECF5CB7CC84"="1"
; Block Office communication app from creating child processes
"26190899-1602-49e8-8b27-eb1d0a1ce869"="1"
; Block persistence through WMI event subscription (Sentinel: WMI persistence)
"e6db77e5-3df2-4cf1-b95a-636979351e5b"="1"
; Block process creations from PSExec and WMI commands (Sentinel: lateral movement)
"92E97FA1-2EDF-4476-BDD6-9DD0B4DDDC7B"="1"
; Block untrusted/unsigned processes from USB (Sentinel: initial access)
"b2b3f03d-6a65-4f7b-a9c7-1c7ef74a9ba4"="1"
; Block Win32 API calls from Office macros (Sentinel: Office macro execution)
"92E97FA1-2EDF-4476-BDD6-9DD0B4DDDC7B"="1"
; Use advanced protection against ransomware (Sentinel: ransomware/wiper impact)
"c1db55ab-c21a-4637-bb3f-a12568109d35"="1"


; -----------------------------------------------------------------------------
; SECTION 9 - SHADOW COPY / VSS HARDENING
; (Sentinel: ShadowDestruction / BackupDestruction / BootRecoveryDisable)
; -----------------------------------------------------------------------------

; VSS service - set to manual (prevent automated tampering; still allows legit backup)
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\VSS]
"Start"=dword:00000003

; Volume Shadow Copy protected storage path ACL note:
; Full VSS ACL hardening requires secedit/icacls - not expressible in .reg

; Disable WMI-based shadow copy deletion path (Sentinel: WbadminDelete / ShadowDelete)
; Restricting vssadmin/wbadmin via SRP is handled in SECTION 12


