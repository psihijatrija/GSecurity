; -----------------------------------------------------------------------------
; SECTION 11 - WORM SURFACE REDUCTION / DCOM / RPC
; Source: Security.reg > Worms Doors Cleaner.reg
; (Sentinel: ReverseShell, DCOM lateral movement)
; -----------------------------------------------------------------------------

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Messenger]
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\NetBT]
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\NetBT\Parameters]
"SmbDeviceEnabled"=dword:00000000

; Disable DCOM (Sentinel: DCOM lateral movement detection)
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Ole]
"EnableDCOM"="N"
"UseInternetPorts"="N"
"LegacyAuthenticationLevel"=dword:00000005
"LegacyImpersonationLevel"=dword:00000003

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Rpc\Internet]
"UseInternetPorts"="N"

; RPC restriction
[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows NT\Rpc]
"RestrictRemoteClients"=dword:00000001

; Disable NetBIOS / LLMNR (Sentinel: DNS tunnel / network recon)
[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows NT\DNSClient]
"EnableNetbios"=dword:00000000

; Disable IPv6 (CVE-2024-38063)
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Tcpip6\Parameters]
"DisabledComponents"=dword:000000ff

; SMBv1 already set above in LanmanServer\Parameters

; Hardened UNC paths (Sentinel: lateral movement / PTH)
[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\NetworkProvider\HardenedPaths]
"\\\\*\\NETLOGON"="RequireMutualAuthentication=1,RequireIntegrity=1"
"\\\\*\\SYSVOL"="RequireMutualAuthentication=1,RequireIntegrity=1"

; Crash dump disable (prevent memory dump of LSASS)
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\CrashControl]
"CrashDumpEnabled"=dword:00000000


