Windows Registry Editor Version 5.00

; =============================================================================
; GSecurity.reg
; Combined: Security + Restrictions + Sentinel-mapped hardening additions
; Generated: 2026-09-02 | Author: Gorstak
; Sources merged:
;   - Security.reg      (LSA/SAM hardening, ASR, TLS, worm surface reduction, UAC COM approval)
;   - Restrictions.reg  (SRP/SAFER, LOLBin blocks, path restrictions)
;   + New additions from Windows Sentinel v4.1 detection mapping:
;       PowerShell logging + constrained language mode
;       AMSI/ScriptBlock logging
;       VSS / shadow copy service hardening
;       WScript / CScript policy disable
;       Defender tamper policy lock
;       Credential Guard enablement
;       LSASS MitigationOptions (CFG + ACG)
;       Scheduled task creation audit
;       DCOM lateral movement restriction
;       AlwaysInstallElevated block (both hives)
;       Additional LOLBin SRP blocks: odbcconf, expand, extrac32, ieexec, msiexec /i http, xwizard
; =============================================================================


; -----------------------------------------------------------------------------
; SECTION 1 - LSA / SAM HARDENING
; Source: Security.reg > GEDR_Hardening_Registry.reg
; -----------------------------------------------------------------------------

; NULL Session Protection
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters]
"RestrictAnonymous"=dword:00000001
"SMB1"=dword:00000000
"DisableCompression"=dword:00000001
"AutoShareWks"=dword:00000000
"restrictnullsessaccess"=dword:00000001
"NullSessionShares"=hex(7):00,00
"NullSessionPipes"=hex(7):00,00

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Lsa]
"RestrictAnonymous"=dword:00000001
"RestrictAnonymousSAM"=dword:00000001
"EveryoneIncludesAnonymous"=dword:00000000
"RunAsPPL"=dword:00000001
"DisableRestrictedAdmin"=dword:00000001
"DisableRestrictedAdminOutboundCreds"=dword:00000001
"wdigest"=dword:00000000
"NoLMHash"=dword:00000001
"SCENoApplyLegacyAuditPolicy"=dword:00000001
"RestrictNullSessAccess"=dword:00000001
"LmCompatibilityLevel"=dword:00000005
"DisableDomainCreds"=dword:00000001
"TokenLeakDetectDelaySecs"=dword:0000001e
"AuditBaseObjects"=dword:00000001
"AuditPerUserAuditing"=dword:00000001

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Lsa\Audit]
"AuditMode"=dword:00000001

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Lsa\MSV1_0]
"RestrictReceivingNTLMTraffic"=dword:00000002
"RestrictSendingNTLMTraffic"=dword:00000002

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Netlogon\Parameters]
"RestrictNullSessAccess"=dword:00000001
"RequireSignOrSeal"=dword:00000001
"RequireStrongKey"=dword:00000001
"SealSecureChannel"=dword:00000001
"SignSecureChannel"=dword:00000001

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\LanManServer\Parameters]
"NullSessionShares"=hex(7):00,00
"NullSessionPipes"=hex(7):00,00


; -----------------------------------------------------------------------------
; SECTION 2 - CREDENTIAL PROTECTION
; -----------------------------------------------------------------------------

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon]
"CachedLogonsCount"="0"
"IgnoreShiftOverride"="1"
"IgnoreShiftOveride"=dword:00000001
"AllowMultipleTSSessions"=dword:00000000

; LSASS CFG + ACG mitigation options (Sentinel: LsassComsvcs / LsassDump detections)
[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Image File Execution Options\LSASS.exe]
"MitigationOptions"=dword:00000031

; Credential Guard (Sentinel: LSASS dump / DPAPI / PTH detections)
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\DeviceGuard]
"EnableVirtualizationBasedSecurity"=dword:00000001
"RequirePlatformSecurityFeatures"=dword:00000001
"HypervisorEnforcedCodeIntegrity"=dword:00000001

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\DeviceGuard\Scenarios\CredentialGuard]
"Enabled"=dword:00000001
"WasEnabledBy"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Virtualization]
"MinVmVersionForCpuBasedMitigations"="1.0"


